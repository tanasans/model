{
  "name": "personal-voice-assistant",
  "version": "1.0.0",
  "description": "\u81ea\u5206\u5c02\u7528AI\u79d8\u66f8\uff08\u65e5\u672c\u8a9e\u97f3\u58f0\u30fb\u30ed\u30fc\u30ab\u30ebMVP\uff09",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:wake": "node scripts/setup-wake-model.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.51.0",
    "vosk-browser": "^0.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "fflate": "^0.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
