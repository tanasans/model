{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests",
    "src/clap/clapDetector.ts",
    "src/clap/calibration.ts"
  ]
}
