{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests",
    "src/clap/clapDetector.ts",
    "src/clap/calibration.ts",
    "src/wake/wakePolicy.ts",
    "src/wake/levelTracker.ts",
    "src/wake/dsp.ts",
    "src/triggerGate.ts",
    "src/ui/coreState.ts",
    "server/voicePreview.ts"
  ]
}
