# ===== 自分専用AI秘書（ローカルMVP）環境変数サンプル =====
# このファイルを「.env」という名前でコピーし、値を設定してください。
# .env は .gitignore 済みです。Gitに絶対に含めないでください。

# 【必須】OpenAI の通常APIキー（サーバー側のみで使用。ブラウザには渡りません）
OPENAI_API_KEY=

# 【任意】Realtimeモデル名（既定: gpt-realtime-2.1）
# 料金を抑えたい場合は mini 系（例: gpt-realtime-2.1-mini）も選べます。
REALTIME_MODEL=gpt-realtime-2.1

# 【任意】AIの既定の声（marin, cedar, ash, echo, ballad, verse, sage, alloy, coral, shimmer）
# 画面の「設定 → 声」で採用した声があれば、そちらが優先されます。
REALTIME_VOICE=marin

# 【任意】1回の会話の最大継続時間（秒）。超えると自動で切断します。上限 1800。
MAX_SESSION_SECONDS=300

# 【任意】APIサーバーのポート（127.0.0.1 のみで待ち受け）
PORT=8787

# ===== 返答の速さ・発話の区切り（VAD）=====
# 推論量（gpt-realtime-2 系モデルのみ有効）: minimal / low / medium / high。既定 low（返答が速い）
# モデルが受け付けない場合は自動で送らない設定に戻ります。
REASONING_EFFORT=low

# 発話の区切り検出: semantic（既定・内容で言い終わりを判定し、途中で割り込みにくい）/ server（無音の長さで判定）
VAD_MODE=semantic
# semantic のときの積極性: low / medium（既定）/ high / auto
#   high は返答が速くなる一方、言いよどみで割り込まれることがあります。
VAD_EAGERNESS=medium
# server のときの「言い終わり」とみなす無音の長さ（ms）。短いほど速いが割り込みやすい。既定 700
VAD_SILENCE_MS=700

# ===== テレビ音声などで会話が途切れる場合の対策（任意。未設定なら従来どおり） =====
# 画面の「音声」タブ →「周囲の音（テレビ）対策」でも切り替えられます（ここの設定に重ねて適用）。
# 入力音声の雑音低減（OpenAI 側）: off（既定）/ near_field（ヘッドセット・近いマイク）/ far_field（PC 内蔵・離れたマイク）
INPUT_NOISE_REDUCTION=off
# 話し始めた音で KAITO の返答を止めるか: 未設定（既定＝止める）/ false（テレビの声で途切れなくなるが、声で割り込めなくなる）
VAD_INTERRUPT_RESPONSE=
# 文字起こしモデル（既定 gpt-4o-mini-transcribe）。精度重視なら gpt-4o-transcribe（料金が上がります）
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# ===== 長期記憶（任意） =====
# 記憶データ（SQLite）と個人設定の保存先。未設定なら Windows は %LOCALAPPDATA%\KAITO（ZIP を入れ替えても消えない場所）
# KAITO_DATA_DIR=
